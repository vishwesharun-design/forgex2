rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Health check test path
    match /test/{docId} {
      allow read, write: if true;
    }

    // Isolated per-user storage: each person's chat and data are strictly private to their authenticated UID
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Global unique registry for creator Studio Names (Once taken, cannot be taken by others)
    match /studioNames/{normalizedName} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null && resource.data.ownerUid == request.auth.uid && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }

    // Global default-deny fallback
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
