{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account profile and usage tier",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "creditsUsed": { "type": "number" },
        "creditsLimit": { "type": "number" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "name", "email"]
    },
    "ChatSession": {
      "title": "ChatSession",
      "description": "Chat session and conversation history",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "modelId": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "messages": { "type": "array" }
      },
      "required": ["id", "userId", "title"]
    },
    "GeneratedImage": {
      "title": "GeneratedImage",
      "description": "AI generated image with generation metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "url": { "type": "string" },
        "prompt": { "type": "string" },
        "aspectRatio": { "type": "string" },
        "style": { "type": "string" },
        "model": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "userId", "url", "prompt"]
    },
    "GeneratedSong": {
      "title": "GeneratedSong",
      "description": "AI generated musical composition and stems",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "genre": { "type": "string" },
        "bpm": { "type": "number" },
        "duration": { "type": "number" },
        "lyrics": { "type": "string" },
        "audioUrl": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "userId", "title", "genre"]
    },
    "FavoriteItem": {
      "title": "FavoriteItem",
      "description": "Saved favorite item bookmarked by user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "userId", "title"]
    },
    "UserSettings": {
      "title": "UserSettings",
      "description": "User preferences, theme and UI configuration",
      "type": "object",
      "properties": {
        "theme": { "type": "string" },
        "themeEffect": { "type": "string" },
        "enableStarBackground": { "type": "boolean" },
        "reduceMotion": { "type": "boolean" },
        "autoSave": { "type": "boolean" },
        "fontSize": { "type": "string" }
      },
      "required": ["theme"]
    },
    "UserWebSearch": {
      "title": "UserWebSearch",
      "description": "Isolated web searches performed by a specific user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "query": { "type": "string" },
        "summary": { "type": "string" },
        "sources": { "type": "array" },
        "searchType": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "userId", "query"]
    },
    "UserVideo": {
      "title": "UserVideo",
      "description": "Isolated AI videos generated by a specific user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "prompt": { "type": "string" },
        "videoUrl": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "userId", "prompt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile with private credentials and storage metrics"
    },
    "/users/{userId}/chats/{chatId}": {
      "schema": "ChatSession",
      "description": "Isolated chat sessions belonging to a specific user"
    },
    "/users/{userId}/images/{imageId}": {
      "schema": "GeneratedImage",
      "description": "Isolated AI images generated by a specific user"
    },
    "/users/{userId}/songs/{songId}": {
      "schema": "GeneratedSong",
      "description": "Isolated AI songs generated by a specific user"
    },
    "/users/{userId}/videos/{videoId}": {
      "schema": "UserVideo",
      "description": "Isolated AI videos generated by a specific user"
    },
    "/users/{userId}/webSearches/{searchId}": {
      "schema": "UserWebSearch",
      "description": "Isolated web search entries created by a specific user"
    },
    "/users/{userId}/favorites/{favId}": {
      "schema": "FavoriteItem",
      "description": "Isolated bookmarks and favorite items for this user"
    },
    "/users/{userId}/settings/{settingId}": {
      "schema": "UserSettings",
      "description": "Isolated settings preferences for this user"
    }
  }
}
